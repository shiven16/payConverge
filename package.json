{
  "name": "payment-state-convergence-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "test": "node --env-file-if-exists=.env --import tsx ./node_modules/vitest/vitest.mjs run",
    "chaos": "node --env-file-if-exists=.env --import tsx src/chaos.ts",
    "demo:send": "node --env-file-if-exists=.env --import tsx src/send-simulated-event.ts",
    "demo:scenario": "node --env-file-if-exists=.env --import tsx src/demo-scenarios.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "sweeper": "node --env-file-if-exists=.env --import tsx src/sweeper.ts"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
